# Copy to .env. Keys are read at runtime and never put in run manifests.
CHARTBREAK_API_KEY=
CHARTBREAK_MODEL=your-provider-model-id
CHARTBREAK_BASE_URL=https://api.openai.com/v1
# For a vLLM endpoint, use a separate model entry in configs/live.json:
# VLLM_API_KEY=local
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=your-served-model-name
